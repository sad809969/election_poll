# Copy to backend/.env (never commit the real file).

# "development" seeds demo data and demo accounts; "production" enforces
# the settings below and never seeds demo data.
ENVIRONMENT=production

# JWT signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Initial password for the "admin" account (min 12 chars). Only used when no
# admin account exists; change it after first sign-in.
ADMIN_INITIAL_PASSWORD=

# PostgreSQL in production, e.g. postgresql://user:pass@host:5432/pollwatch
DATABASE_URL=

# Persistent directory for uploaded Form EC8A photos.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

DEBUG=False
